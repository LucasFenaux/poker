#!/usr/bin/env bash

# Grab the first command line argument ($1).
# If no argument is provided, default to 3.
KEEP=${1:-3}

echo "Starting cleanup..."
echo "Keeping the $KEEP most recent runs and deleting the rest."

# We also clean up tb_logs directly in case there are orphaned logs (where the run folder was already deleted)
docker compose run --rm casino_backend bash -c "cd /app/results && \
  for dir in \$(ls -d run_* 2>/dev/null | head -n -$KEEP); do rm -rf \$dir tb_logs/\$dir; done && \
  cd tb_logs 2>/dev/null && \
  for dir in \$(ls -d run_* 2>/dev/null | head -n -$KEEP); do rm -rf \$dir; done"

echo "Cleanup complete! Note: You must restart TensorBoard for it to remove the deleted runs from the UI."
echo "Run: docker compose restart tensorboard"